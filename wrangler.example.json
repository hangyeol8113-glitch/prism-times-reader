{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prism-times-reader",
  "main": "dist/worker.js",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/admin",
      "/admin/",
      "/api/*",
      "/editions.json",
      "/index.html",
      "/studio.html"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prism-times-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "prism-times-papers"
    }
  ],
  "observability": {
    "enabled": true
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prism-times-reader",
  "main": "dist/worker.js",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/admin",
      "/admin/",
      "/api/*",
      "/editions.json",
      "/index.html",
      "/studio.html"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prism-times-db",
      "database_id": "ee215810-6153-4463-b8c9-e5ed57b7bd97",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "PDF_STORAGE",
      "id": "6927ca12dfbb4b2c861a34f26ab3bdb5"
    }
  ],
  "vars": {
    "READER_URL": "https://hangyeol8113-glitch.github.io/prism-times-reader/",
    "EMPTY_START": "true"
  },
  "account_id": "4e89d0a1e135c419768a60ac9c511e86"
}
